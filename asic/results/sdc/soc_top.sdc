###############################################################################
# Created by write_sdc
###############################################################################
current_design soc_top
###############################################################################
# Timing Constraints
###############################################################################
create_clock -name clk_i -period 20.0000 [get_ports {clk_i}]
set_clock_transition 0.1500 [get_clocks {clk_i}]
set_clock_uncertainty 0.2500 clk_i
set_propagated_clock [get_clocks {clk_i}]
create_clock -name jtag_clk -period 100.0000 [get_ports {jtag_tck}]
set_propagated_clock [get_clocks {jtag_clk}]
set_clock_groups -name group1 -asynchronous \
 -group [get_clocks {clk_i}]\
 -group [get_clocks {jtag_clk}]
set_input_delay 4.0000 -clock [get_clocks {clk_i}] -add_delay [get_ports {gpio_i[0]}]
