+    // ASIC: accept one read, capture the falling-edge SRAM output at
+    // the next rising edge, then advertise RVALID with registered data.
+    // Keep the response stable until RREADY. FPGA behavior is unchanged.
+`ifdef USE_SRAM_MACRO
+    logic macro_read_pending;
+    assign s_axil_arready = rst_n && !macro_read_pending && !s_axil_rvalid;
+    always_ff @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            macro_read_pending <= 1'b0;
+            s_axil_rvalid <= 1'b0;
+            s_axil_rresp <= RESP_OKAY;
+        end else begin
+            macro_read_pending <= s_axil_arvalid && s_axil_arready;
+            if (macro_read_pending) begin
+                s_axil_rvalid <= 1'b1;
+                s_axil_rresp <= RESP_OKAY;
+            end else if (s_axil_rvalid && s_axil_rready) begin
+                s_axil_rvalid <= 1'b0;
+            end
+        end
+    end
+`else
     // --- AXI Okuma Kontrol Yazmaçları (Async reset içerir) ---
     always_ff @(posedge clk or negedge rst_n) begin
         if (!rst_n) begin
